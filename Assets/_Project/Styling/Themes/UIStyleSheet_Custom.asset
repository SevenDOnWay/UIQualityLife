    fontAsset: {fileID: 0}
    overrideAnimation: 0
    animationClass: {fileID: 0}
  - selector: .btn-primary
    description: 'Imported rule from Figma: .btn-primary'
    overrideBackground: 1
    backgroundColorToken: colors-primary
    overrideBorder: 0
    borderColorToken: border
    borderWidthToken: border-thin
    overrideCornerRadius: 1
    cornerRadiusToken: radii-button
    overrideCornerStyle: 0
